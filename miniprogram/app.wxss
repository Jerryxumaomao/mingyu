/* 乾坤 · 宣纸主题(新中式:宣纸白 + 墨字 + 朱砂印)
   排版基准 v2:正文 32rpx / 行高 1.75(用户反馈原 28rpx 偏小、行距不足) */
page { background: #f4eddc; color: #33302a; font-size: 32rpx; line-height: 1.75; font-family: "Noto Serif SC", "Songti SC", serif; }
.card { background: #fbf7ec; border: 1rpx solid #e6dcc6; border-radius: 22rpx; padding: 32rpx; margin: 22rpx 24rpx; box-shadow: 0 2rpx 10rpx rgba(90, 70, 30, .05); }
.gold { color: #b5432f; }           /* 强调=朱砂(类名沿用,免全站改名) */
.ink { color: #33302a; }
.muted { color: #8a8272; font-size: 26rpx; line-height: 1.7; }
.en { font-family: Georgia, serif; font-size: 18rpx; letter-spacing: 3rpx; color: #b3a98f; text-transform: uppercase; }
.go { background: #b5432f; color: #fbf3e2; border-radius: 16rpx; margin: 22rpx 24rpx; letter-spacing: 8rpx; font-size: 32rpx; }
input, picker { background: #fbf7ec; border: 1rpx solid #e6dcc6; border-radius: 12rpx; padding: 14rpx 18rpx; margin: 10rpx 0; color: #33302a; }
.label { color: #8a8272; font-size: 26rpx; margin-top: 18rpx; }
/* 汉字方章图标:描边墨章 / 实底朱砂章 */
.glyph { width: 88rpx; height: 88rpx; border-radius: 20rpx; border: 4rpx solid #33302a; color: #33302a;
  display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 700; flex: none; }
.glyph.zhu { background: #b5432f; border-color: #b5432f; color: #fbf3e2; }
/* 印章 */
.seal { width: 84rpx; height: 84rpx; border-radius: 12rpx; background: #b5432f; color: #fbf3e2;
  display: flex; align-items: center; justify-content: center; text-align: center;
  font-size: 30rpx; font-weight: 700; line-height: 1.15; }
.vtxt { writing-mode: vertical-rl; letter-spacing: 16rpx; font-weight: 700; }
/* 半宽格子(仿新中式两列排布) */
.tile { flex: 1; background: #fbf7ec; border: 2rpx solid #d8cdb4; border-radius: 20rpx; padding: 28rpx; min-width: 0; }
.tile-row { display: flex; gap: 20rpx; margin: 0 24rpx 22rpx; }
/* 色块:竖长条(仿调色板样式,替代圆点) */
.swatch { width: 52rpx; height: 52rpx; border-radius: 50%; border: 2rpx solid rgba(51, 48, 42, .15); flex: none; }
.cbar { width: 88rpx; height: 176rpx; border-radius: 999rpx; border: 2rpx solid rgba(51, 48, 42, .1); box-shadow: 0 6rpx 14rpx rgba(90, 70, 30, .12); flex: none; }
.cbar-s { width: 56rpx; height: 118rpx; border-radius: 999rpx; border: 2rpx solid rgba(51, 48, 42, .1); flex: none; }
.cbar-m { width: 30rpx; height: 64rpx; border-radius: 999rpx; flex: none; }
.cbar-xs { width: 22rpx; height: 44rpx; border-radius: 999rpx; flex: none; align-self: flex-end; }
.wxp { display: inline-flex; align-items: center; justify-content: center; min-width: 46rpx; height: 46rpx;
  border-radius: 10rpx; font-size: 26rpx; font-weight: 700; color: #fbf3e2; margin-right: 8rpx; padding: 0 6rpx; flex: none; }
.cardtitle { font-size: 34rpx; font-weight: 700; letter-spacing: 4rpx; }
/* 开屏 */
.splash { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 999; }
.splash-out { animation: splashOut .5s ease forwards; }
@keyframes splashOut { to { opacity: 0; } }

/* ── 动效库(浮入/翻牌/盖章/弹现/朱砂呼吸)── */
@keyframes rise { from { opacity: 0; transform: translateY(40rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes flipIn { from { opacity: 0; transform: rotateY(85deg) scale(.9); } to { opacity: 1; transform: rotateY(0) scale(1); } }
@keyframes stamp { 0% { opacity: 0; transform: scale(2) rotate(-16deg); } 55% { opacity: 1; transform: scale(.9) rotate(4deg); } 100% { opacity: 1; transform: scale(1) rotate(0deg); } }
@keyframes popIn { from { opacity: 0; transform: scale(.5); } to { opacity: 1; transform: scale(1); } }
@keyframes breathe { 0%, 100% { text-shadow: 0 0 6rpx rgba(181, 67, 47, .15); opacity: .92; } 50% { text-shadow: 0 0 24rpx rgba(181, 67, 47, .5); opacity: 1; } }
.ani-rise { animation: rise .5s cubic-bezier(.2, .7, .3, 1) both; }
.ani-flip { animation: flipIn .55s cubic-bezier(.2, .7, .3, 1) both; }
.ani-stamp { animation: stamp .55s cubic-bezier(.2, .8, .3, 1.1) both; }
.ani-pop { animation: popIn .4s cubic-bezier(.34, 1.56, .64, 1) both; }
.breathe { animation: breathe 3s ease-in-out infinite; }
.d1 { animation-delay: .05s; } .d2 { animation-delay: .13s; } .d3 { animation-delay: .21s; }
.d4 { animation-delay: .29s; } .d5 { animation-delay: .37s; } .d6 { animation-delay: .45s; }
.btn-press { transform: scale(.95); opacity: .85; }
.go { transition: transform .12s ease; }
