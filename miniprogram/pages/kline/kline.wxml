<view class="card ani-rise" wx:if="{{natal}}">
  <view style="display:flex; justify-content:space-between; align-items:center">
    <view class="muted" style="min-width:0">{{natal}}</view>
    <view class="en" style="flex:none; margin-left:12rpx">{{isSelf ? 'MY CHART' : 'FOR FRIEND'}}</view>
  </view>
  <canvas type="2d" id="kc" bindtap="goBig" style="width:100%;height:480rpx;margin-top:16rpx"></canvas>
  <view class="muted" hover-class="btn-press" bindtap="goBig" style="text-align:center; margin-top:8rpx">点图放大 · 横屏看逐年分值 ›</view>
  <view style="margin-top:12rpx" wx:if="{{best}}">🔺 {{best}}  🔻 {{worst}}</view>
</view>

<view class="card ani-rise" wx:if="{{!natal && !busy && !showForm}}">
  <view class="cardtitle">全程还未铺开</view>
  <view class="muted" style="margin-top:10rpx">设置本人档案后,这里会自动生成;也可以点下方按钮帮别人看看。</view>
  <navigator url="/pages/profile/profile"><view class="gold" style="margin-top:12rpx">去设置档案 ›</view></navigator>
</view>

<view wx:if="{{showForm}}" class="card ani-rise">
  <view class="cardtitle" style="font-size:30rpx">换一个出生信息</view>
  <view class="label">出生日期</view>
  <picker mode="date" value="{{date}}" start="1600-01-01" end="2100-12-31" bindchange="onDate"><view>{{date}}</view></picker>
  <view class="label">时辰 / 性别</view>
  <view style="display:flex;gap:16rpx">
    <picker style="flex:1" range="{{times}}" value="{{ti}}" bindchange="onTime"><view>{{times[ti]}}</view></picker>
    <picker style="flex:1" range="{{genders}}" value="{{gi}}" bindchange="onGender"><view>{{genders[gi]}}</view></picker>
  </view>
  <button class="go" style="margin:24rpx 0 4rpx" hover-class="btn-press" bindtap="run" disabled="{{busy}}">{{busy ? '正在推演…' : '生成'}}</button>
</view>

<button wx:if="{{!showForm}}" class="go" style="background:transparent; color:#b5432f; border:2rpx solid #b5432f"
  hover-class="btn-press" bindtap="toggleForm">帮 TA 看看</button>

<view class="muted" style="text-align:center;margin:30rpx">分数为传统规则的量化表达,仅供文化研究与娱乐</view>
