<navbar title="疗愈祈愿" back="{{true}}"/>

<!-- 引导:三步,大白话 -->
<view class="card ani-rise" wx:if="{{!r}}">
  <view class="cardtitle">求签三诀 <text class="en" style="margin-left:8rpx">Before You Ask</text></view>
  <view style="margin-top:14rpx; display:flex; gap:16rpx; align-items:baseline">
    <text class="gold" style="font-weight:700; flex:none">凝</text>
    <text style="font-size:28rpx">凝神静气,心中默念一事。所问越明,所断越清——"这周面试成与不成",胜过"我运气如何"。</text>
  </view>
  <view style="margin-top:10rpx; display:flex; gap:16rpx; align-items:baseline">
    <text class="gold" style="font-weight:700; flex:none">数</text>
    <text style="font-size:28rpx">念定之后,信手报一数,不必思量。第一个冒出来的,就是它。</text>
  </view>
  <view style="margin-top:10rpx; display:flex; gap:16rpx; align-items:baseline">
    <text class="gold" style="font-weight:700; flex:none">观</text>
    <text style="font-size:28rpx">抽签之后,观其起、观其变、观其落。一事一签,不必再问。</text>
  </view>
</view>

<view class="card ani-rise d1">
  <view class="label">抽签方式</view>
  <picker range="{{methods}}" value="{{mi}}" bindchange="onMethod"><view>{{methods[mi]}}</view></picker>
  <view wx:if="{{mi === 0}}">
    <view class="label">心中念着所问,报一数</view>
    <input type="number" value="{{num}}" bindinput="onNum" placeholder="信手一数,如 37"/>
  </view>
  <view wx:if="{{mi === 1}}" class="muted" style="margin-top:12rpx">按当下时刻抽签,两小时之内签文相同,古法如此;若想多问,改用报数。</view>
</view>
<button class="go" hover-class="btn-press" bindtap="run">抽 签</button>

<view wx:if="{{r}}">
  <view class="card">
    <view class="muted">{{r.methodLabel}} · 农历{{r.lunarMonth}}月{{r.lunarDay}}日 {{r.hourLabel}}</view>
    <view style="display:flex;text-align:center;margin-top:16rpx">
      <view style="flex:1" class="ani-flip d{{index + 1}}" wx:for="{{r.palaces}}" wx:key="index">
        <view class="muted">{{item.t}}</view>
        <view class="gold" style="font-size:40rpx">{{item.name}}</view>
      </view>
    </view>
    <view class="ani-rise d4" style="margin-top:16rpx" wx:for="{{r.lines}}" wx:key="index">{{item}}</view>
    <view style="margin-top:14rpx; padding:16rpx 20rpx; background:rgba(181,67,47,.06); border-radius:14rpx">断语:{{r.advice}}</view>
    <view class="muted" style="margin-top:10rpx">见分晓约在:{{r.timing}} · 利于方位:{{r.direction}}</view>
  </view>
  <button class="go" style="background:transparent; color:#b5432f; border:2rpx solid #b5432f" hover-class="btn-press" bindtap="reset" wx:if="{{mi !== 1}}">换个问题,再抽一签</button>
</view>
<view class="muted" style="text-align:center;margin:30rpx">签文仅供文化参考与娱乐,行止仍在人为</view>
