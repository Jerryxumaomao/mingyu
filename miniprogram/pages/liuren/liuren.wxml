<view class="card">
  <view class="label">起课方式</view>
  <picker range="{{methods}}" value="{{mi}}" bindchange="onMethod"><view>{{methods[mi]}}</view></picker>
  <view wx:if="{{mi === 1}}">
    <view class="label">心中默念所问,报一个数</view>
    <input type="number" value="{{num}}" bindinput="onNum" placeholder="任意正整数,如 37"/>
  </view>
</view>
<button class="go" hover-class="btn-press" bindtap="run">起 卦</button>
<view wx:if="{{r}}">
  <view class="card">
    <view class="muted">{{r.methodLabel}} · 农历{{r.lunarMonth}}月{{r.lunarDay}}日 {{r.hourLabel}}</view>
    <view style="display:flex;text-align:center;margin-top:16rpx">
      <view style="flex:1" class="ani-flip d{{index + 1}}" wx:for="{{r.palaces}}" wx:key="index">
        <view class="muted">{{item.t}}</view>
        <view class="gold" style="font-size:40rpx">{{item.name}}</view>
        <view class="muted">{{item.element}}·{{item.fortune}}</view>
      </view>
    </view>
    <view class="ani-rise d4" style="margin-top:16rpx" wx:for="{{r.lines}}" wx:key="index">{{item}}</view>
    <view class="muted" style="margin-top:12rpx">建议:{{r.advice}}</view>
    <view class="muted">应期:{{r.timing}} · 方位:{{r.direction}}</view>
  </view>
</view>
<view class="muted" style="text-align:center;margin:30rpx">占卜结果仅供参考娱乐</view>
