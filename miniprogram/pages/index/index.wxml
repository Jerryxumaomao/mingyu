<!-- 开屏(冷启动一次,轻触跳过) -->
<view wx:if="{{splash}}" class="splash {{splashFade ? 'splash-out' : ''}}" bindtap="skipSplash">
  <image src="/assets/splash.jpg" mode="aspectFill" binderror="onSplashError" style="width:100%;height:100%"/>
</view>

<view style="padding-top:{{padTop}}px; padding-bottom:30rpx">
  <!-- 头卡:品牌 + 今日概览 -->
  <view class="card ani-rise" style="padding:46rpx 36rpx 34rpx; position:relative; overflow:hidden">
    <image src="/assets/deco-branch.png" mode="widthFix" style="position:absolute; right:-14rpx; top:-6rpx; width:210rpx; opacity:.35"/>
    <view style="display:flex; justify-content:space-between; height:300rpx">
      <view style="display:flex">
        <view class="vtxt breathe" style="font-size:58rpx; color:#33302a">观变玩占</view>
        <view class="vtxt muted" style="letter-spacing:17rpx; margin-right:20rpx; font-weight:400">观其变而玩其占</view>
      </view>
      <view wx:if="{{today}}" class="muted" style="align-self:center; text-align:center; line-height:2">
        <view style="font-size:24rpx">{{today.date}}</view>
        <view style="font-size:30rpx; letter-spacing:4rpx; color:#33302a; margin-top:4rpx">今日{{today.element}}气当值</view>
      </view>
      <view class="seal ani-stamp" style="align-self:flex-end; width:64rpx; height:64rpx; font-size:22rpx; line-height:1.2">玩<br/>占</view>
    </view>
    <view wx:if="{{today}}" style="display:flex; gap:24rpx; margin-top:18rpx; align-items:baseline; flex-wrap:wrap">
      <view style="display:flex; gap:10rpx; align-items:baseline">
        <text style="font-size:32rpx; font-weight:700; color:#b5432f; flex:none">宜</text>
        <text style="font-size:26rpx">{{today.yi}}</text>
      </view>
      <view style="display:flex; gap:10rpx; align-items:baseline">
        <text style="font-size:32rpx; font-weight:700; color:#3f7050; flex:none">忌</text>
        <text style="font-size:26rpx">{{today.ji}}</text>
      </view>
    </view>
    <view wx:else class="muted" style="letter-spacing:4rpx; margin-top:18rpx">每日更新 · 传统文化生活日历</view>
  </view>

  <!-- 今日指数 + 今日五行色 -->
  <view wx:if="{{today}}" class="card ani-rise d1" style="display:flex; align-items:center; gap:24rpx">
    <view style="flex:1; min-width:0">
      <view class="cardtitle">今日 <text class="en" style="margin-left:8rpx">Today · {{today.god}}日</text></view>
      <view style="margin-top:14rpx; display:flex; align-items:baseline; gap:14rpx">
        <text style="font-size:60rpx; font-weight:700; color:{{today.bandColor}}">{{today.element}}</text>
        <text class="muted">气当值</text>
      </view>
      <view style="display:flex; align-items:flex-end; gap:12rpx; margin-top:16rpx">
        <view class="cbar-m" wx:for="{{today.colors.main}}" wx:key="n" style="background:{{item.c}}"></view>
        <view class="cbar-xs" wx:for="{{today.colors.accent}}" wx:key="n" style="background:{{item.c}}"></view>
      </view>
      <view class="muted" style="margin-top:12rpx; font-size:24rpx">{{today.elementLine}}</view>
    </view>
    <view style="width:200rpx; flex:none; display:flex; align-items:center; justify-content:center">
      <image class="ani-stamp" src="/assets/qian-{{today.qi}}.png" mode="aspectFit" style="width:200rpx; height:240rpx; transform:rotate(-3deg)"/>
    </view>
  </view>

  <!-- 今日穿搭入口 -->
  <view class="card ani-rise d3" hover-class="btn-press" bindtap="goOutfit" style="position:relative; overflow:hidden; display:flex; align-items:center; gap:20rpx">
    <image src="/assets/deco-robe.png" mode="widthFix" style="position:absolute; right:10rpx; top:50%; transform:translateY(-50%); width:170rpx; opacity:.28"/>
    <view class="glyph zhu" style="width:64rpx; height:64rpx; font-size:34rpx; border-radius:14rpx">衣</view>
    <view style="flex:1">
      <view class="cardtitle" style="font-size:30rpx">今日穿搭</view>
      <view class="muted" style="margin-top:2rpx">今日色系穿搭 · 从你的衣橱里挑</view>
    </view>
    <view class="muted" style="font-size:36rpx; flex:none">›</view>
  </view>

  <!-- 十二生肖今日入口(预览四个) -->
  <view class="card ani-rise d4" hover-class="btn-press" bindtap="goZodiac">
    <view style="display:flex; justify-content:space-between; align-items:center">
      <view class="cardtitle" style="font-size:30rpx">十二生肖今日 <text class="en" style="margin-left:8rpx">Zodiac</text></view>
      <view class="muted" style="font-size:36rpx">›</view>
    </view>
    <view wx:if="{{zodiacs}}" style="display:flex; gap:14rpx; margin-top:16rpx">
      <view wx:for="{{zodiacs}}" wx:key="animal" style="flex:1; text-align:center; padding:14rpx 0; border-radius:14rpx; border:2rpx solid #e6dcc6">
        <view style="font-size:34rpx; font-weight:700">{{item.animal}}</view>
        <view style="font-size:20rpx; margin-top:2rpx; color:{{item.color}}">{{item.tag}}</view>
      </view>
    </view>
    <view class="muted" style="margin-top:12rpx; font-size:24rpx">十二生肖各自的今日提点,点击看全部</view>
  </view>

  <view class="muted ani-rise d5" style="text-align:center; margin:34rpx">传统文化生活日历 · 仅供文化欣赏与娱乐</view>
</view>
