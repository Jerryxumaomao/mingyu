<!-- 开屏(冷启动一次,轻触跳过) -->
<view wx:if="{{splash}}" class="splash {{splashFade ? 'splash-out' : ''}}" bindtap="skipSplash">
  <image src="/assets/splash.jpg" mode="aspectFill" style="width:100%;height:100%"/>
</view>

<view style="padding-top:{{padTop}}px; padding-bottom:30rpx">
  <!-- 头卡:品牌 + 四柱档案 -->
  <navigator url="/pages/profile/profile">
    <view class="card ani-rise" hover-class="btn-press" style="padding:46rpx 36rpx 34rpx; position:relative; overflow:hidden">
      <image src="/assets/deco-branch.png" mode="widthFix" style="position:absolute; right:-14rpx; top:-6rpx; width:210rpx; opacity:.35"/>
      <view style="display:flex; justify-content:space-between; height:300rpx">
        <view style="display:flex">
          <view class="vtxt breathe" style="font-size:58rpx; color:#33302a">观变玩占</view>
          <view class="vtxt muted" style="letter-spacing:17rpx; margin-right:20rpx; font-weight:400">观其变而玩其占</view>
        </view>
        <view wx:if="{{pillars}}" style="display:flex; gap:22rpx; align-self:center; margin-top:20rpx">
          <view wx:for="{{pillars}}" wx:key="n" style="display:flex; flex-direction:column; align-items:center; gap:4rpx">
            <view class="muted" style="font-size:22rpx">{{item.n}}</view>
            <view style="font-size:46rpx; font-weight:700; line-height:1.25; color:{{item.day ? '#b5432f' : '#33302a'}}">{{item.g}}</view>
            <view style="font-size:46rpx; font-weight:700; line-height:1.25; color:{{item.day ? '#b5432f' : '#33302a'}}">{{item.z}}</view>
          </view>
        </view>
        <view wx:else class="muted" style="align-self:center; text-align:center; line-height:2.1">
          <view style="font-size:28rpx">尚未设置本人档案</view>
          <view style="font-size:24rpx">点击录入 · 四柱常驻此处</view>
        </view>
        <view class="seal ani-stamp" style="align-self:flex-end; font-size:40rpx">档</view>
      </view>
      <view class="muted" style="letter-spacing:4rpx; margin-top:18rpx">{{profDesc}}</view>
    </view>
  </navigator>

  <!-- 今日穿搭:主色/辅色速览 → 穿搭页 -->
  <view class="card ani-rise d1" hover-class="btn-press" bindtap="goOutfit" style="position:relative; overflow:hidden; padding:36rpx 32rpx 40rpx">
    <image src="/assets/deco-robe.png" mode="widthFix" style="position:absolute; right:16rpx; top:20rpx; width:210rpx; opacity:.3"/>
    <view style="display:flex; align-items:center; gap:18rpx">
      <view class="glyph zhu" style="width:64rpx; height:64rpx; font-size:34rpx; border-radius:14rpx">衣</view>
      <view>
        <view class="cardtitle">今日穿搭</view>
        <view class="en" style="margin-top:2rpx">Outfit of the Day</view>
      </view>
    </view>
    <view wx:if="{{dash}}" style="margin-top:24rpx">
      <view style="display:flex; align-items:center; gap:12rpx">
        <text class="muted" style="flex:none">主色</text>
        <view class="cbar-m" wx:for="{{dash.main}}" wx:key="n" style="background:{{item.c}}"></view>
        <text wx:if="{{dash.main.length}}" style="font-size:28rpx">{{dash.main[0].n}}</text>
      </view>
      <view style="display:flex; align-items:center; gap:12rpx; margin-top:12rpx">
        <text class="muted" style="flex:none">辅色</text>
        <view class="cbar-m" wx:for="{{dash.accent}}" wx:key="n" style="background:{{item.c}}; width:22rpx; height:46rpx"></view>
        <text wx:if="{{dash.accent.length}}" class="muted">{{dash.accent[0].n}}</text>
      </view>
    </view>
    <view wx:else class="muted" style="margin-top:16rpx">{{pillars ? '正在为你调色…' : '设置档案后,每日开运色自动点亮'}}</view>
  </view>

  <!-- 喜忌 + 今年运势 -->
  <view class="tile-row ani-rise d2">
    <view class="tile" hover-class="btn-press" bindtap="goPaipan">
      <view class="cardtitle" style="font-size:30rpx">命盘喜忌</view>
      <view class="en" style="margin-top:4rpx">Useful God</view>
      <view wx:if="{{dash}}" style="margin-top:16rpx">
        <view style="display:flex; align-items:center; flex-wrap:wrap; row-gap:8rpx; margin-bottom:10rpx">
          <text class="muted" style="margin-right:8rpx">喜</text>
          <view class="wxp" wx:for="{{dash.fav}}" wx:key="w" style="background:{{item.c}}">{{item.w}}</view>
        </view>
        <view style="display:flex; align-items:center; flex-wrap:wrap; row-gap:8rpx">
          <text class="muted" style="margin-right:8rpx">忌</text>
          <view class="wxp" wx:for="{{dash.unf}}" wx:key="w" style="background:transparent; border:2rpx solid {{item.c}}; color:{{item.c}}">{{item.w}}</view>
        </view>
        <view class="muted" style="margin-top:12rpx">日主{{dash.strength}} · 详盘 ›</view>
      </view>
      <view wx:else class="muted" style="margin-top:16rpx">设置档案后显示</view>
    </view>
    <view class="tile" hover-class="btn-press" bindtap="goKline">
      <view class="cardtitle" style="font-size:30rpx">今年运势</view>
      <view class="en" style="margin-top:4rpx">This Year</view>
      <view wx:if="{{dash && dash.year}}" style="margin-top:16rpx">
        <view style="display:flex; align-items:baseline; gap:10rpx">
          <text style="font-size:56rpx; font-weight:700; color:#b5432f">{{dash.year.score}}</text>
          <text class="muted">分 · {{dash.year.lv}}</text>
        </view>
        <view class="muted" style="margin-top:12rpx">{{dash.year.y}} {{dash.year.gz}}年 · 看全程 ›</view>
      </view>
      <view wx:else class="muted" style="margin-top:16rpx">{{pillars ? '正在推演…' : '设置档案后显示'}}</view>
    </view>
  </view>

  <!-- 合婚 + 起卦 -->
  <view class="tile-row ani-rise d3">
    <view class="tile" hover-class="btn-press" bindtap="goHehun" style="display:flex; align-items:center; gap:20rpx">
      <view class="glyph" style="width:76rpx; height:76rpx; font-size:38rpx">合</view>
      <view style="min-width:0">
        <view class="cardtitle" style="font-size:30rpx">八字合婚</view>
        <view class="en" style="margin-top:2rpx">Match</view>
      </view>
    </view>
    <view class="tile" hover-class="btn-press" bindtap="goLiuren" style="display:flex; align-items:center; gap:20rpx">
      <view class="glyph" style="width:76rpx; height:76rpx; font-size:38rpx">卦</view>
      <view style="min-width:0">
        <view class="cardtitle" style="font-size:30rpx">小六壬起卦</view>
        <view class="en" style="margin-top:2rpx">Divination</view>
      </view>
    </view>
  </view>

  <view class="muted ani-rise d4" style="text-align:center; margin:34rpx">仅供文化研究与娱乐</view>
</view>
