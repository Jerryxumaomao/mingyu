<navbar title="今日穿搭"/>
<view wx:if="{{today}}">
  <!-- 今日色彩:大色卡 -->
  <view class="card ani-rise">
    <view style="display:flex; justify-content:space-between; align-items:center">
      <view class="cardtitle">今日色彩 <text class="en" style="margin-left:8rpx">Colors</text></view>
      <view class="en" style="flex:none">{{today.element}}日宜色</view>
    </view>
    <view style="display:flex; gap:26rpx; margin-top:24rpx; align-items:flex-end">
      <view wx:for="{{today.colors.main}}" wx:key="n" style="display:flex; flex-direction:column; align-items:center; gap:10rpx">
        <view class="cbar" style="background:{{item.c}}"></view>
        <text style="font-size:24rpx">{{item.n}}</text>
      </view>
      <view style="width:1rpx; height:140rpx; background:#e6dcc6; align-self:center"></view>
      <view wx:for="{{today.colors.accent}}" wx:key="n" style="display:flex; flex-direction:column; align-items:center; gap:10rpx">
        <view class="cbar-s" style="background:{{item.c}}"></view>
        <text class="muted" style="font-size:22rpx">{{item.n}}</text>
      </view>
    </view>
    <view class="muted" style="margin-top:20rpx; font-size:24rpx">{{today.elementLine}}</view>
  </view>

  <!-- 一周色卡入口:七段彩带 -->
  <view class="card ani-rise d1" wx:if="{{week}}" hover-class="btn-press" bindtap="goWeek" style="display:flex; align-items:center; gap:22rpx">
    <view style="flex:1; min-width:0">
      <view class="cardtitle" style="font-size:30rpx">未来一周 <text class="en" style="margin-left:8rpx">Week Colors</text></view>
      <view style="display:flex; gap:6rpx; margin-top:14rpx">
        <view wx:for="{{week}}" wx:key="index" style="flex:1; text-align:center">
          <view style="height:22rpx; background:{{item.c}}; border-radius:{{index === 0 ? '999rpx 4rpx 4rpx 999rpx' : index === 6 ? '4rpx 999rpx 999rpx 4rpx' : '4rpx'}}"></view>
          <view style="font-size:20rpx; margin-top:6rpx; color:{{item.today ? '#b5432f' : '#8a8272'}}; font-weight:{{item.today ? '700' : '400'}}">{{item.label}}</view>
        </view>
      </view>
      <view class="muted" style="margin-top:10rpx; font-size:24rpx">每日宜色都排好了,出行提前配</view>
    </view>
    <view class="muted" style="font-size:36rpx; flex:none">›</view>
  </view>

  <!-- 配饰 + 香调 -->
  <view class="tile-row ani-rise d2">
    <view class="tile">
      <view style="font-weight:700; font-size:29rpx">配饰 <text class="en">Wear</text></view>
      <view style="display:flex; gap:10rpx; flex-wrap:wrap; margin-top:14rpx">
        <view wx:for="{{today.acc}}" wx:key="index" style="padding:6rpx 18rpx; border-radius:999rpx; border:2rpx solid #d8cdb4; font-size:24rpx">{{item}}</view>
      </view>
    </view>
    <view class="tile">
      <view style="font-weight:700; font-size:29rpx">香调 <text class="en">Scent</text></view>
      <view style="display:flex; gap:10rpx; flex-wrap:wrap; margin-top:14rpx">
        <view wx:for="{{today.scent}}" wx:key="index" style="padding:6rpx 18rpx; border-radius:999rpx; border:2rpx solid #d8cdb4; font-size:24rpx">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 搭配:从我的衣橱里挑(新用户空态盖蒙版) -->
  <view class="card ani-rise d3" wx:if="{{owned}}" style="position:relative; overflow:hidden">
    <view class="cardtitle" style="font-size:30rpx">搭配 <text class="en" style="margin-left:8rpx">My Picks</text></view>
    <block wx:if="{{!owned.empty}}">
      <view wx:if="{{owned.mats.length}}" style="display:flex; align-items:center; gap:12rpx; margin-top:16rpx; flex-wrap:wrap">
        <text style="font-weight:700; flex:none">戴</text>
        <view wx:for="{{owned.mats}}" wx:key="index" style="padding:8rpx 20rpx; border-radius:999rpx; background:#b5432f; color:#fbf3e2; font-size:25rpx">{{item}}</view>
      </view>
      <view wx:if="{{owned.perfumes.length}}" style="margin-top:12rpx">
        <view style="display:flex; gap:12rpx; margin-top:6rpx" wx:for="{{owned.perfumes}}" wx:key="index">
          <text style="font-weight:700; flex:none">喷</text><text style="font-size:27rpx">{{item}}</text>
        </view>
      </view>
      <view wx:if="{{!owned.mats.length && !owned.perfumes.length}}" class="muted" style="margin-top:14rpx">已有单品与今日色系暂无重合,可参考上方通用推荐</view>
      <view class="muted" hover-class="btn-press" bindtap="goWardrobe" style="margin-top:16rpx">管理我的衣橱 ›</view>
    </block>
    <block wx:else>
      <view style="display:flex; align-items:center; gap:12rpx; margin-top:16rpx">
        <text style="font-weight:700; flex:none">戴</text>
        <view wx:for="{{[1, 2, 3]}}" wx:key="*this" style="width:120rpx; height:52rpx; border-radius:999rpx; border:2rpx dashed #d8cdb4"></view>
      </view>
      <view style="display:flex; align-items:center; gap:12rpx; margin-top:14rpx">
        <text style="font-weight:700; flex:none">喷</text>
        <view style="width:280rpx; height:52rpx; border-radius:999rpx; border:2rpx dashed #d8cdb4"></view>
      </view>
      <view style="position:absolute; left:0; top:0; right:0; bottom:0; background:rgba(51,48,42,.42); display:flex; align-items:center; justify-content:center">
        <view hover-class="btn-press" bindtap="goWardrobe"
          style="background:#b5432f; color:#fbf3e2; padding:18rpx 46rpx; border-radius:999rpx; font-size:29rpx; letter-spacing:4rpx; box-shadow:0 6rpx 16rpx rgba(0,0,0,.28)">＋ 添加配饰 / 香水</view>
        <view style="position:absolute; left:0; right:0; bottom:14rpx; text-align:center; color:#fbf3e2; font-size:22rpx; letter-spacing:2rpx; opacity:.8">登记一次,每天从你有的里面挑</view>
      </view>
    </block>
  </view>
</view>

<view class="muted" style="text-align:center;margin:30rpx">灵感源自传统文化配色,仅供风格参考与娱乐</view>
