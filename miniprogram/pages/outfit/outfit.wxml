<navbar title="今日五行穿搭"/>
<view wx:if="{{r}}">
  <!-- 今日色彩:大色卡,少文字 -->
  <view class="card ani-rise">
    <view style="display:flex; justify-content:space-between; align-items:center">
      <view class="cardtitle">今日色彩 <text class="en" style="margin-left:8rpx">Colors</text></view>
      <view class="en" style="flex:none">{{isSelf ? 'FOR ME' : 'FOR FRIEND'}} · {{r.dayGz}}日</view>
    </view>
    <view style="display:flex; gap:26rpx; margin-top:24rpx; align-items:flex-end">
      <view wx:for="{{r.main}}" wx:key="n" style="display:flex; flex-direction:column; align-items:center; gap:10rpx">
        <view class="cbar" style="background:{{item.c}}"></view>
        <text style="font-size:24rpx">{{item.n}}</text>
      </view>
      <view style="width:1rpx; height:140rpx; background:#e6dcc6; align-self:center"></view>
      <view wx:for="{{r.accent}}" wx:key="n" style="display:flex; flex-direction:column; align-items:center; gap:10rpx">
        <view class="cbar-s" style="background:{{item.c}}"></view>
        <text class="muted" style="font-size:22rpx">{{item.n}}</text>
      </view>
    </view>
    <view style="display:flex; align-items:center; gap:12rpx; margin-top:22rpx; flex-wrap:wrap">
      <text class="muted" style="font-size:24rpx; flex:none">今天别碰</text>
      <view wx:for="{{r.avoid}}" wx:key="n" style="display:flex; align-items:center; gap:6rpx; padding:4rpx 16rpx; border-radius:999rpx; border:2rpx solid #e6dcc6">
        <view style="width:20rpx; height:20rpx; border-radius:50%; background:{{item.c}}; opacity:.5"></view>
        <text class="muted" style="font-size:22rpx; text-decoration:line-through">{{item.n}}</text>
      </view>
    </view>
  </view>

  <!-- 衣橱适配 -->
  <view class="card ani-rise d1" wx:if="{{owned && !owned.empty}}">
    <view class="cardtitle" style="font-size:30rpx">👝 从你的衣橱挑 <text class="en" style="margin-left:8rpx">My Picks</text></view>
    <view wx:if="{{owned.mats.length}}" style="display:flex; align-items:center; gap:12rpx; margin-top:14rpx; flex-wrap:wrap">
      <text style="font-weight:700; flex:none">戴</text>
      <view wx:for="{{owned.mats}}" wx:key="index" style="padding:8rpx 20rpx; border-radius:999rpx; background:#b5432f; color:#fbf3e2; font-size:25rpx">{{item}}</view>
    </view>
    <view wx:if="{{owned.perfumes.length}}" style="margin-top:12rpx">
      <view style="display:flex; gap:12rpx; margin-top:6rpx" wx:for="{{owned.perfumes}}" wx:key="index">
        <text style="font-weight:700; flex:none">喷</text><text style="font-size:27rpx">{{item}}</text>
      </view>
    </view>
    <view wx:if="{{!owned.mats.length && !owned.perfumes.length}}" class="muted" style="margin-top:12rpx">已有单品与今日喜用暂无重合,看下方通用推荐</view>
    <view class="muted" hover-class="btn-press" bindtap="goWardrobe" style="margin-top:14rpx">管理我的衣橱 ›</view>
  </view>
  <view class="card ani-rise d1" wx:elif="{{isSelf}}" hover-class="btn-press" bindtap="goWardrobe">
    <view class="cardtitle" style="font-size:30rpx">👝 登记我的衣橱 <text class="en" style="margin-left:8rpx">Wardrobe</text></view>
    <view class="muted" style="margin-top:8rpx">勾配饰、加香水,以后直接从你有的里面挑 ›</view>
  </view>

  <!-- 配饰 + 香调:两列并排 chips -->
  <view class="tile-row ani-rise d2">
    <view class="tile">
      <view style="font-weight:700; font-size:29rpx">配饰 <text class="en">Wear</text></view>
      <view style="display:flex; gap:10rpx; flex-wrap:wrap; margin-top:14rpx">
        <view wx:for="{{r.acc}}" wx:key="index" style="padding:6rpx 18rpx; border-radius:999rpx; border:2rpx solid #d8cdb4; font-size:24rpx">{{item}}</view>
      </view>
    </view>
    <view class="tile">
      <view style="font-weight:700; font-size:29rpx">香调 <text class="en">Scent</text></view>
      <view style="display:flex; gap:10rpx; flex-wrap:wrap; margin-top:14rpx">
        <view wx:for="{{r.scent}}" wx:key="index" style="padding:6rpx 18rpx; border-radius:999rpx; background:rgba(181,67,47,.1); color:#b5432f; font-size:24rpx">{{item}}</view>
        <view wx:for="{{r.scentAvoid}}" wx:key="index" style="padding:6rpx 18rpx; border-radius:999rpx; border:2rpx solid #e6dcc6; color:#8a8272; font-size:24rpx; text-decoration:line-through">{{item}}</view>
      </view>
    </view>
  </view>

  <view class="card ani-rise d3" wx:if="{{r.notes.length}}">
    <view wx:for="{{r.notes}}" wx:key="index" class="muted" style="margin-top:{{index ? '8rpx' : '0'}}">✦ {{item}}</view>
  </view>
</view>

<view class="card ani-rise" wx:if="{{!r && !busy && !showForm}}">
  <view class="cardtitle">今日色彩还未点亮</view>
  <view class="muted" style="margin-top:10rpx">设置本人档案后,这里每天自动生成;也可以点下方按钮帮别人配一配。</view>
  <navigator url="/pages/profile/profile"><view class="gold" style="margin-top:12rpx">去设置档案 ›</view></navigator>
</view>

<view wx:if="{{showForm}}" class="card ani-rise">
  <view class="cardtitle" style="font-size:30rpx">换一个出生信息</view>
  <view class="label">出生日期</view>
  <picker mode="date" value="{{date}}" start="1600-01-01" end="2100-12-31" bindchange="onDate"><view>{{date}}</view></picker>
  <view style="display:flex;gap:16rpx">
    <picker style="flex:1" range="{{times}}" value="{{ti}}" bindchange="onTime"><view>{{times[ti]}}</view></picker>
    <picker style="flex:1" range="{{genders}}" value="{{gi}}" bindchange="onGender"><view>{{genders[gi]}}</view></picker>
  </view>
  <view class="label">看哪天</view>
  <picker mode="date" value="{{target}}" bindchange="onTarget"><view>{{target}}</view></picker>
  <button class="go" style="margin:24rpx 0 4rpx" hover-class="btn-press" bindtap="run" disabled="{{busy}}">{{busy ? '正在调色…' : '生成穿搭建议'}}</button>
</view>

<button wx:if="{{!showForm}}" class="go" style="background:transparent; color:#b5432f; border:2rpx solid #b5432f"
  hover-class="btn-press" bindtap="toggleForm">帮 TA 看看</button>

<view class="muted" style="text-align:center;margin:30rpx">五行取象为传统主流口径,仅供风格参考与娱乐</view>
