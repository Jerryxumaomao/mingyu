<!-- 日/年切换(仿参考图 segmented) -->
<view style="display:flex; gap:12rpx; margin:24rpx 24rpx 0">
  <view data-m="day" bindtap="switchMode"
    style="padding:12rpx 36rpx; border-radius:999rpx; font-size:29rpx; {{mode === 'day' ? 'background:#b5432f; color:#fbf3e2; font-weight:700' : 'color:#8a8272; border:2rpx solid #d8cdb4'}}">日运</view>
  <view data-m="year" bindtap="switchMode"
    style="padding:12rpx 36rpx; border-radius:999rpx; font-size:29rpx; {{mode === 'year' ? 'background:#b5432f; color:#fbf3e2; font-weight:700' : 'color:#8a8272; border:2rpx solid #d8cdb4'}}">年运</view>
  <view wx:if="{{mode === 'year'}}" class="muted" hover-class="btn-press" bindtap="goBig" style="margin-left:auto; align-self:center">横屏放大 ›</view>
</view>

<view class="card" style="margin-top:20rpx; padding:20rpx">
  <view class="muted" style="font-size:23rpx; margin-bottom:8rpx">{{natalStr}}</view>
  <canvas type="2d" id="fc" bindtouchstart="onTouch" bindtouchmove="onTouch" style="width:100%; height:420rpx"></canvas>
  <view class="muted" style="text-align:center; font-size:23rpx; margin-top:6rpx">在图上按住滑动选择{{mode === 'day' ? '日期' : '年份'}}</view>
</view>

<!-- 选中解读卡 -->
<view class="card ani-pop" wx:if="{{sel}}">
  <view style="display:flex; justify-content:space-between; align-items:center">
    <view style="font-weight:700; font-size:31rpx">{{sel.title}} <text wx:if="{{sel.isToday}}" class="gold" style="font-size:24rpx">◉ {{sel.kind === 'day' ? '今天' : '今年'}}</text></view>
    <view style="display:flex; align-items:baseline; gap:8rpx; flex:none">
      <text style="font-size:44rpx; font-weight:700; color:{{sel.color}}">{{sel.score}}</text>
      <text style="font-size:27rpx; font-weight:700; color:{{sel.color}}">{{sel.band}}</text>
    </view>
  </view>
  <block wx:if="{{sel.kind === 'day'}}">
    <view style="display:flex; gap:14rpx; margin-top:16rpx">
      <text style="font-weight:700; color:#b5432f; flex:none">宜</text><text style="font-size:28rpx">{{sel.yi}}</text>
    </view>
    <view style="display:flex; gap:14rpx; margin-top:8rpx">
      <text style="font-weight:700; color:#3f7050; flex:none">忌</text><text style="font-size:28rpx">{{sel.ji}}</text>
    </view>
    <view wx:if="{{sel.note}}" class="muted" style="margin-top:10rpx">{{sel.note}}</view>
  </block>
  <block wx:else>
    <view class="muted" style="margin-top:12rpx">{{sel.text}}</view>
    <view class="muted" style="margin-top:8rpx; font-size:24rpx">{{sel.range}}{{sel.dayun ? ' · ' + sel.dayun : ''}}</view>
  </block>
</view>

<view class="muted" style="text-align:center; margin:30rpx">分数为传统规则的量化表达,仅供文化研究与娱乐</view>
