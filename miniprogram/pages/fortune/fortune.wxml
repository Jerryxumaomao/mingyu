<navbar title="运势"/>
<block wx:if="{{hasProfile && today}}">
  <!-- 今日运势打分:左信息右圆环,环心吉凶大字 -->
  <view class="card ani-rise" hover-class="btn-press" bindtap="goDay" style="display:flex; align-items:center; gap:24rpx">
    <view style="flex:1; min-width:0">
      <view class="cardtitle">今日运势 <text class="en" style="margin-left:8rpx">Today</text></view>
      <view class="muted" style="margin-top:8rpx">{{today.date}} · 流日 {{today.gz}}</view>
      <view style="margin-top:12rpx; display:flex; align-items:baseline; gap:10rpx">
        <text style="font-size:68rpx; font-weight:700; color:{{bandColor}}">{{today.score}}</text>
        <text class="muted">分</text>
      </view>
      <view style="width:250rpx; height:14rpx; background:#efe7d3; border-radius:999rpx; margin-top:12rpx; overflow:hidden">
        <view style="width:{{today.score}}%; height:100%; background:{{bandColor}}; border-radius:999rpx"></view>
      </view>
      <view wx:if="{{today.notes.length}}" class="muted" style="font-size:24rpx; margin-top:10rpx">{{today.notes[0]}}</view>
    </view>
    <!-- 吉凶大字:玩占行书,居右半区正中 -->
    <view style="width:45%; flex:none; display:flex; align-items:center; justify-content:center">
      <image class="ani-stamp" src="/assets/qian-{{qi}}.png" mode="aspectFit"
        style="width:{{qi === 0 || qi === 4 ? 150 : 210}}rpx; height:280rpx"/>
    </view>
  </view>

  <!-- 左:宜忌大卡(解读入口) 右:日运/年运缩略图 -->
  <view class="tile-row ani-rise d1" style="align-items:stretch">
    <view class="tile" hover-class="btn-press" bindtap="goDay" style="flex:1.25; display:flex; flex-direction:column; padding:0">
      <view style="flex:1; display:flex; align-items:center; gap:16rpx; padding:0 28rpx">
        <text style="font-size:52rpx; font-weight:700; color:#b5432f">宜</text>
        <view style="font-size:27rpx; line-height:1.5">{{today.yi[0]}}<view class="muted" style="font-size:24rpx">{{today.yi[1]}}{{today.yi[2] ? ' · ' + today.yi[2] : ''}}</view></view>
      </view>
      <view style="border-top:1rpx dashed #d8cdb4; margin:0 28rpx"></view>
      <view style="flex:1; display:flex; align-items:center; gap:16rpx; padding:0 28rpx">
        <text style="font-size:52rpx; font-weight:700; color:#3f7050">忌</text>
        <view style="font-size:27rpx; line-height:1.5">{{today.ji[0]}}<view class="muted" style="font-size:24rpx">{{today.ji[1] || ''}}</view></view>
      </view>
    </view>
    <view style="flex:1; display:flex; flex-direction:column; gap:20rpx">
      <view class="tile" hover-class="btn-press" bindtap="goDay">
        <view style="font-weight:700; font-size:28rpx">日运 <text class="en">7 Days</text></view>
        <canvas type="2d" id="dthumb" style="width:100%; height:90rpx; margin-top:8rpx"></canvas>
      </view>
      <view class="tile" hover-class="btn-press" bindtap="goYear">
        <view style="font-weight:700; font-size:28rpx">年运 <text class="en">Life</text></view>
        <canvas type="2d" id="ythumb" style="width:100%; height:90rpx; margin-top:8rpx"></canvas>
      </view>
    </view>
  </view>

  <!-- 今日五行 -->
  <view class="card ani-rise d2" wx:if="{{wx5}}">
    <view class="cardtitle" style="font-size:30rpx">今日五行 <text class="en" style="margin-left:8rpx">{{today.gz}} · Five Elements</text></view>
    <view style="display:flex; gap:14rpx; margin-top:18rpx">
      <view wx:for="{{wx5}}" wx:key="w" style="flex:1; text-align:center; padding:16rpx 0; border-radius:14rpx; border:2rpx solid {{item.day ? item.c : '#e6dcc6'}}; background:{{item.day ? item.c : 'transparent'}}">
        <view style="font-size:34rpx; font-weight:700; line-height:1.3; color:{{item.day ? '#fbf3e2' : item.c}}">{{item.w}}</view>
        <view style="font-size:20rpx; color:{{item.day ? '#fbf3e2' : '#8a8272'}}">{{item.tag}}</view>
      </view>
    </view>
    <view class="muted" style="margin-top:14rpx">{{wxLine}}</view>
  </view>

  <!-- 今日开运色(联动穿搭) -->
  <view class="card ani-rise d3" wx:if="{{colors}}" hover-class="btn-press" bindtap="goOutfit" style="display:flex; align-items:center; gap:20rpx">
    <view style="flex:1">
      <view class="cardtitle" style="font-size:30rpx">今日开运色 <text class="en" style="margin-left:8rpx">Lucky Colors</text></view>
      <view style="display:flex; align-items:flex-end; gap:14rpx; margin-top:12rpx">
        <view class="cbar-m" wx:for="{{colors.main}}" wx:key="n" style="background:{{item.c}}"></view>
        <view class="cbar-xs" wx:for="{{colors.accent}}" wx:key="n" style="background:{{item.c}}"></view>
      </view>
    </view>
    <view class="muted" style="font-size:36rpx">›</view>
  </view>
</block>

<view class="card ani-rise" wx:if="{{!hasProfile}}">
  <view class="cardtitle">运势还未点亮</view>
  <view class="muted" style="margin-top:10rpx">设置本人档案后,今日吉凶、日运、年运会在这里自动生成。</view>
  <navigator url="/pages/profile/profile"><view class="gold" style="margin-top:12rpx">去设置档案 ›</view></navigator>
</view>

<view class="muted ani-rise d4" style="text-align:center; margin:30rpx">分数为传统规则的量化表达,仅供文化研究与娱乐</view>
