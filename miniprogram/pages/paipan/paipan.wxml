<navbar title="生辰五行" back="{{true}}"/>
<view wx:if="{{r}}">
  <view class="card ani-rise">
    <view style="display:flex; justify-content:flex-end"><text class="en">{{isSelf ? 'MY CHART' : 'FOR FRIEND'}}</text></view>
    <view style="display:flex;text-align:center">
      <view style="flex:1" class="ani-flip d{{index + 1}}" wx:for="{{r.zhus}}" wx:key="index"><view class="muted">{{item.n}}</view><view class="gold" style="font-size:44rpx">{{item.gz}}</view></view>
    </view>
    <view class="ani-rise d4" style="margin-top:16rpx">日主 <text class="gold">{{r.dm}}</text> · {{r.status}}({{r.score}}分)</view>
    <view class="ani-rise d5">喜 <text class="gold">{{r.fav}}</text> 忌 {{r.unf}}</view>
    <view class="muted ani-rise d5" wx:for="{{r.warnings}}" wx:key="index">⚠ {{item}}</view>
  </view>
  <view class="card ani-rise d5">
    <view class="cardtitle" style="font-size:30rpx">这盘怎么读 <text class="en" style="margin-left:8rpx">Notes</text></view>
    <view wx:for="{{r.explain}}" wx:key="q" style="display:flex; gap:18rpx; margin-top:18rpx">
      <view style="flex:none; min-width:88rpx; text-align:center; align-self:flex-start; padding:6rpx 14rpx; border:2rpx solid #b5432f; border-radius:10rpx; color:#b5432f; font-size:26rpx; font-weight:700">{{item.q}}</view>
      <view style="font-size:28rpx; line-height:1.7">{{item.a}}</view>
    </view>
  </view>
</view>

<view class="card ani-rise" wx:if="{{!r && !busy && !showForm}}">
  <view class="cardtitle">盘面还未展开</view>
  <view class="muted" style="margin-top:10rpx">设置本人档案后,这里会自动生成;也可以点下方按钮帮别人看。</view>
  <navigator url="/pages/profile/profile"><view class="gold" style="margin-top:12rpx">去设置档案 ›</view></navigator>
</view>

<view wx:if="{{showForm}}" class="card ani-rise">
  <view class="cardtitle" style="font-size:30rpx">换一个出生信息</view>
  <view class="label">出生日期</view>
  <picker mode="date" value="{{date}}" start="1600-01-01" end="2100-12-31" bindchange="onDate"><view>{{date}}</view></picker>
  <view style="display:flex;gap:16rpx">
    <picker style="flex:1" range="{{times}}" value="{{ti}}" bindchange="onTime"><view>{{times[ti]}}</view></picker>
    <picker style="flex:1" range="{{genders}}" value="{{gi}}" bindchange="onGender"><view>{{genders[gi]}}</view></picker>
  </view>
  <button class="go" style="margin:24rpx 0 4rpx" hover-class="btn-press" bindtap="run" disabled="{{busy}}">{{busy ? '正在生成…' : '立即生成'}}</button>
</view>

<button wx:if="{{!showForm}}" class="go" style="background:transparent; color:#b5432f; border:2rpx solid #b5432f"
  hover-class="btn-press" bindtap="toggleForm">帮 TA 看看</button>

<view class="muted" style="text-align:center;margin:30rpx">仅供文化研究与娱乐</view>
