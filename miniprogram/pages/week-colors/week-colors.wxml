<navbar title="一周色卡" back="{{true}}"/>

<view wx:if="{{days}}">
  <view class="card week-card ani-rise {{item.delayClass}} {{item.currentClass}}" wx:for="{{days}}" wx:key="dateKey">
    <view class="week-summary" data-date-key="{{item.dateKey}}" bindtap="toggleDay"
      hover-class="week-summary-press" hover-stay-time="80" aria-role="button" aria-label="{{item.a11yLabel}}">
      <view class="week-meta">
        <view class="week-label {{item.today ? 'gold' : ''}}">{{item.label}}</view>
        <view class="muted week-date">{{item.date}}</view>
        <view class="muted week-element" wx:if="{{item.el}}">{{item.el}}气</view>
      </view>
      <view class="week-mini-palette">
        <view class="cbar-m" wx:for="{{item.main}}" wx:for-item="color" wx:key="n" style="background:{{color.c}}"></view>
        <view class="cbar-xs" wx:for="{{item.accent}}" wx:for-item="color" wx:key="n" style="background:{{color.c}}"></view>
      </view>
      <view class="week-result">
        <view class="week-name">{{item.name}}</view>
        <view class="muted week-toggle">{{item.toggleText}}</view>
      </view>
    </view>

    <view class="week-detail hairline-top ani-rise" wx:if="{{item.expanded}}">
      <block wx:if="{{!item.unavailable}}">
        <view class="week-guidance">{{item.elementLine}}</view>

        <view class="week-section">
          <view class="week-section-title">宜作主色 <text class="en">Base</text></view>
          <view class="week-color-list">
            <view class="week-color-item" wx:for="{{item.main}}" wx:for-item="color" wx:key="n">
              <view class="cbar-m" style="background:{{color.c}}"></view>
              <text class="week-color-name">{{color.n}}</text>
            </view>
          </view>
        </view>

        <view class="week-section">
          <view class="week-section-title">适合点缀 <text class="en">Accent</text></view>
          <view class="week-color-list">
            <view class="week-color-item" wx:for="{{item.accent}}" wx:for-item="color" wx:key="n">
              <view class="cbar-xs" style="background:{{color.c}}"></view>
              <text class="week-color-name">{{color.n}}</text>
            </view>
          </view>
        </view>

        <view class="week-section" wx:if="{{item.avoidColors.length}}">
          <view class="week-section-title">当天别碰 <text class="en">Avoid</text></view>
          <view class="week-chip-list">
            <view class="chip chip-bad" wx:for="{{item.avoidColors}}" wx:for-item="color" wx:key="n">{{color.n}}</view>
          </view>
        </view>

        <view class="week-pair">
          <view class="week-pair-section">
            <view class="week-section-title">配饰 <text class="en">Wear</text></view>
            <view class="week-chip-list">
              <view class="chip" wx:for="{{item.acc}}" wx:for-item="accessory" wx:key="*this">{{accessory}}</view>
            </view>
          </view>
          <view class="week-pair-section">
            <view class="week-section-title">香调 <text class="en">Scent</text></view>
            <view class="week-chip-list">
              <view class="chip" wx:for="{{item.scent}}" wx:for-item="family" wx:key="*this">{{family}}</view>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="week-guidance">{{item.elementLine}}</view>
    </view>
  </view>
  <view class="muted week-footer ani-rise d6">每日当值色 · 灵感源自传统文化 · 仅供文化研究与娱乐</view>
</view>
