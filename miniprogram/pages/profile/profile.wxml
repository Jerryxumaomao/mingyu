<view class="card ani-rise" style="display:flex;align-items:center;gap:20rpx">
  <view class="glyph zhu">档</view>
  <view>
    <view style="font-weight:700;letter-spacing:4rpx">本人档案</view>
    <view class="muted">存在本机 · 五个功能自动带入 · 填城市与精确时间可启用真太阳时</view>
  </view>
</view>
<view class="card ani-rise d1">
  <view class="label">出生日期</view>
  <picker mode="date" value="{{date}}" start="1600-01-01" end="2100-12-31" bindchange="onDate"><view>{{date}}</view></picker>
  <view class="label">时辰 / 性别</view>
  <view style="display:flex;gap:16rpx">
    <picker style="flex:1" range="{{times}}" value="{{ti}}" bindchange="onTime"><view>{{times[ti]}}</view></picker>
    <picker style="flex:1" range="{{genders}}" value="{{gi}}" bindchange="onGender"><view>{{genders[gi]}}</view></picker>
  </view>
  <view class="label">出生城市(可选,自动查经度)</view>
  <input value="{{city}}" bindinput="onCity" placeholder="如:长春 / 深圳"/>
  <view class="label">精确出生时间(可选,如 03:15)</view>
  <input value="{{hm}}" bindinput="onHm" placeholder="HH:MM,与城市一起填才生效"/>
</view>
<button class="go" hover-class="btn-press" bindtap="save">保 存 档 案</button>
<view wx:if="{{preview}}" class="card ani-pop">
  <view class="muted">档案四柱预览{{tsNote}}</view>
  <view style="display:flex;text-align:center;margin-top:12rpx">
    <view style="flex:1" class="ani-flip d{{index + 1}}" wx:for="{{preview}}" wx:key="index">
      <view class="muted">{{item.n}}</view>
      <view class="gold" style="font-size:40rpx">{{item.gz}}</view>
    </view>
  </view>
</view>
<view wx:if="{{hasProfile}}" style="text-align:center;margin:10rpx">
  <text class="muted" style="text-decoration:underline" bindtap="clearProfile">清除本机档案</text>
</view>
<view class="muted" style="text-align:center;margin:30rpx">仅供文化研究与娱乐</view>
